# Xolotl, linux/amd64, NVIDIA CUDA: the Xolotl engines built FROM SOURCE and served by serve/server.py.
#
# This is the fork's container build (birdrock00/Xolotl). It differs from the repo-root Dockerfile, which packages the
# Strata Terminal and an engine component package: this one compiles the Xolotl engines directly and ships a plain
# runtime that runs `python -m serve.server --engine strata`, which is how Xolotl's own docs run Inkling-2-Mini,
# xolotl-dense and friends. No installer, no update feed, no /data volume: mount the model, set the env, run.
#
#   docker build -f docker/Dockerfile.xolotl-cuda -t xolotl:cuda .                       # sm_89 (RTX 40) only
#   docker build -f docker/Dockerfile.xolotl-cuda --build-arg CUDA_ARCHITECTURES="86;89;120" -t xolotl:fat .
#
#   docker run --rm --gpus all -p 127.0.0.1:8080:8080 --shm-size 8g \
#     -v /path/to/models:/models:ro \
#     -e INKLING_GGUF=/models/Inkling-2-Mini-XQ-Uncensored.gguf \
#     -e INKLING_TOKENIZER=/models/inkling-tokenizer \
#     -e INKLING_CTX=32768 \
#     xolotl:cuda
#
# `docker build` has no GPU, so the card is named by CUDA_ARCHITECTURES instead of read from nvidia-smi. Keep it to the
# card you have: every extra architecture is a whole extra pass over 165 .cu files.
#
# Plain legacy-builder features only (no heredocs, no --mount), matching the style of the repo's other Dockerfiles.

ARG CUDA_IMAGE=nvidia/cuda:13.0.0-devel-ubuntu24.04
ARG RUNTIME_IMAGE=nvidia/cuda:13.0.0-runtime-ubuntu24.04

# ---- 1. compile the engines -------------------------------------------------------------
FROM ${CUDA_IMAGE} AS build
# /venv/bin first: requirements-build.txt pins CMake and Ninja, and the CUDA image's own
# apt cmake (if any) is older than what CMakeLists.txt asks for.
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PATH=/venv/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates git curl ninja-build libgomp1 libatomic1 \
        python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src

# Pinned Python (serve/server.py + tools) and the pinned CMake/Ninja, before the sources: a source-only change does not
# pay for the wheel installs again.
COPY requirements.txt requirements-build.txt ./
RUN python3 -m venv /venv \
    && /venv/bin/pip install --no-cache-dir --upgrade pip \
    && /venv/bin/pip install --no-cache-dir -r requirements.txt -r requirements-build.txt
COPY . .

# llama.cpp at the pinned commit + tools/xolotl/ggml/xolotl-ggml.patch (the same script the source build uses).
# third_party/llama.cpp is in .dockerignore, so this clone is always the pinned commit, never a host leftover.
RUN set -e; mkdir -p third_party; \
    git clone --filter=blob:none -q https://github.com/ggml-org/llama.cpp.git third_party/llama.cpp || true; \
    bash tools/xolotl/fetch-llama.sh

ARG CUDA_ARCHITECTURES=89
ARG BUILD_TARGETS="xolotl-inkling xolotl-inkling-dspark xolotl-dense"
# Flags as in AGENTS.md (the inkling section of docs/INKLING.md builds the same way). STRATA_PORTABLE keeps the CPU
# code at an AVX2 baseline so an image built on a CI runner still runs on an older desktop CPU.
RUN cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DSTRATA_ENABLE_CUDA=ON -DSTRATA_GGML_CUDA=ON -DSTRATA_MMQ_KQUANTS=ON -DSTRATA_PORTABLE=ON \
        -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES} \
        -DSTRATA_GGML_DIR=/src/third_party/llama.cpp \
        -DSTRATA_DSV41_FQ_OP=ON -DSTRATA_DSV41_HC_MIX=ON \
    && cmake --build build --target ${BUILD_TARGETS} -j "$(nproc)"

# stage what the runtime needs: the engine binaries, any shared objects (static ggml today, so usually none),
# the Python serving layer and the tools it imports
RUN set -e; mkdir -p /stage/bin /stage/lib; \
    for t in xolotl-inkling xolotl-inkling-dspark xolotl-dense strata; do \
        [ -f "build/$t" ] && cp "build/$t" /stage/bin/ || true; done; \
    strip --strip-debug /stage/bin/* 2>/dev/null || strip /stage/bin/* || true; \
    find build -name '*.so*' -maxdepth 3 -exec cp -av {} /stage/lib/ \; 2>/dev/null || true; \
    ldd /stage/bin/xolotl-inkling

# ---- 2. the runtime --------------------------------------------------------------------
FROM ${RUNTIME_IMAGE}
ARG STRATA_VERSION=dev
ARG IMAGE_VERSION=dev
LABEL org.opencontainers.image.title="Xolotl (CUDA, amd64)" \
      org.opencontainers.image.description="Xolotl engines (xolotl-inkling, xolotl-dense) behind the OpenAI/Anthropic server" \
      org.opencontainers.image.source="https://github.com/birdrock00/Xolotl" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.licenses="MIT"

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1 \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    LANG=C.UTF-8 HOME=/tmp
RUN apt-get update && apt-get install -y --no-install-recommends \
        tini ca-certificates python3 libgomp1 libatomic1 procps curl \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

COPY --from=build /venv /opt/xolotl/venv
COPY --from=build /stage/bin /opt/xolotl/bin
COPY --from=build /stage/lib /opt/xolotl/lib
# the serving layer and the tools it imports (no C++ sources, no build tree, no vendored llama.cpp)
COPY serve/                       /opt/xolotl/app/serve/
COPY tools/                       /opt/xolotl/app/tools/
COPY configs/                     /opt/xolotl/app/configs/
COPY data/                        /opt/xolotl/app/data/
COPY bench/                       /opt/xolotl/app/bench/
COPY bin/                         /opt/xolotl/app/bin/
COPY strata.py setup.py requirements.txt /opt/xolotl/app/
COPY docker/inkling-entrypoint.sh /opt/xolotl/entrypoint.sh
# the venv is a thin layer over the system interpreter, so prove it resolves inside THIS image
RUN chmod 0755 /opt/xolotl/entrypoint.sh /opt/xolotl/bin/* 2>/dev/null || true
RUN /opt/xolotl/venv/bin/python3 -c "import numpy, jinja2; print('venv ok, numpy', numpy.__version__)"
ENV LD_LIBRARY_PATH=/opt/xolotl/lib \
    PATH=/opt/xolotl/bin:/opt/xolotl/venv/bin:$PATH \
    PORT=8080
WORKDIR /opt/xolotl/app
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=30m --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/xolotl/entrypoint.sh"]
CMD ["serve"]
